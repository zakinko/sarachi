#!/bin/sh
# 回復環境の init。WinPE 相当の入口にあたる。
#
# ここは RAM 上の tmpfs で走る。ディスクは一切マウントしない。
# WinRE が winre.wim を丸ごと RAM に載せてから走るのと同じ理由で、
# 消去の対象に自分が乗っていると、消した瞬間に自分が消えるため。

/bin/busybox --install -s /bin 2>/dev/null

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
# udhcpc は一時ファイルと pid の置き場を要る。RAM 上の揮発領域で足りる。
mkdir -p /run /etc 2>/dev/null
mount -t tmpfs tmpfs /run 2>/dev/null

# 依存順はビルド時に確定している。ここは並べて読むだけ。
if [ -f /modules.load ]; then
    while read -r m; do
        [ -f "$m" ] && insmod "$m" 2>/dev/null
    done < /modules.load
fi

echo
echo "=============================================="
echo " unix-mdm recovery environment"
echo "=============================================="

echo "-- 自分がどこで走っているか --"
echo "   root fs : $(awk '$2=="/" {print $3}' /proc/mounts)"
printf '   memory  : %s MiB\n' "$(( $(awk '/MemTotal/{print $2}' /proc/meminfo) / 1024 ))"
printf '   kernel  : %s %s\n' "$(uname -r)" "$(uname -m)"

echo "-- ディスクが見えているか --"
found=0
for d in /sys/block/*; do
    n=${d##*/}
    case "$n" in loop*|ram*) continue ;; esac
    sz=$(cat "$d/size" 2>/dev/null || echo 0)
    [ "$sz" -gt 0 ] || continue
    printf '   %-10s %s MiB\n' "$n" "$(( sz / 2048 ))"
    found=$((found + 1))
done
[ "$found" -eq 0 ] && echo "   (なし)"

echo "-- ネットワークが見えているか --"
found=0
for d in /sys/class/net/*; do
    n=${d##*/}
    [ "$n" = lo ] && continue
    printf '   %-10s %s\n' "$n" "$(cat "$d/address" 2>/dev/null)"
    found=$((found + 1))
done
[ "$found" -eq 0 ] && echo "   (なし)"

# ネットワークは必要な時だけ上げる。WinRE も既定では常時接続を持たない。
# 有線が挿さっていればそれが一番速いので先に試す。
if grep -q unixmdm.net /proc/cmdline 2>/dev/null; then
    echo "-- ネットワークを上げる --"
    ifconfig lo 127.0.0.1 up 2>/dev/null
    for d in /sys/class/net/*; do
        n=${d##*/}
        [ "$n" = lo ] && continue
        ifconfig "$n" up 2>/dev/null
        # -n で一度きり。回復環境は常駐しないので更新は要らない。
        # -q でリース取得後に抜ける。取れなければ次の口を試す。
        if udhcpc -i "$n" -n -q -t 5 -T 3 -s /usr/share/udhcpc/default.script > /run/dhcp.log 2>&1; then
            addr=$(ifconfig "$n" 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')
            printf '   %-10s %s\n' "$n" "${addr:-取れず}"
            [ -n "$addr" ] && break
        else
            printf '   %-10s DHCP 取得に失敗\n' "$n"
            sed 's/^/     /' /run/dhcp.log 2>/dev/null | head -8
        fi
    done
    [ -f /etc/resolv.conf ] && sed 's/^/   dns: /' /etc/resolv.conf
fi

if [ -x /bin/unix-mdm-recovery ]; then
    echo "-- unix-mdm-recovery から見たディスク --"
    /bin/unix-mdm-recovery list
    # unixmdm.partition=<dev> が与えられていれば、そのディスクを実際に切る。
    # 与えられなければ配置を表示するだけで何も書かない。
    # unixmdm.install=<base-url> が与えられていれば、取得して書き戻す。
    BASE=$(sed -n 's/.*unixmdm\.install=\([^ ]*\).*/\1/p' /proc/cmdline)
    DEST=$(sed -n 's/.*unixmdm\.dest=\([^ ]*\).*/\1/p' /proc/cmdline)
    if [ -n "$BASE" ] && [ -n "$DEST" ]; then
        echo "-- $DEST へ $BASE から書き戻す --"
        /bin/unix-mdm-recovery install "$DEST" \
            --manifest "$BASE/test.manifest" \
            --image "$BASE/test.img" \
            --key /etc/unix-mdm.pub \
            --commit
    fi

    TARGET=$(sed -n 's/.*unixmdm\.partition=\([^ ]*\).*/\1/p' /proc/cmdline)
    if [ -n "$TARGET" ]; then
        echo "-- $TARGET を実際に切る --"
        /bin/unix-mdm-recovery partition "$TARGET" --commit
    else
        for d in /sys/block/vdb /sys/block/sdb /sys/block/nvme1n1; do
            [ -d "$d" ] || continue
            echo "-- ${d##*/} に対する配置（dry-run）--"
            /bin/unix-mdm-recovery plan "${d##*/}"
            break
        done
    fi
fi

echo
echo "root は一切マウントしていない。ディスクは消去できる状態にある。"
echo "=============================================="
echo

# 無人で検証する時は、報告だけして止まる。回復環境は最終的に
# 誰も見ていない場所で走るので、対話シェルに落ちない経路が本番の姿になる。
if grep -q unixmdm.autotest /proc/cmdline 2>/dev/null; then
    echo "autotest: 報告を終えたので停止する"
    poweroff -f
fi

exec /bin/sh
