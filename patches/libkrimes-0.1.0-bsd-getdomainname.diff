Bind res on the BSDs as well.

get_domainname() binds res only under cfg(target_os = "macos") and
cfg(target_os = "linux"), so on any other target the following
"if res == -1" refers to a value that was never bound:

  error[E0425]: cannot find value `res` in this scope

The second argument differs by platform, and the libc crate already
groups them the way this patch does: unix/bsd/freebsdlike declares
c_int, as unix/bsd/apple does, and unix/bsd/netbsdlike declares size_t,
as unix/linux_like does.  So the BSDs can join the two existing arms
and no new arm is needed.

--- src/cldap.rs.orig
+++ src/cldap.rs
@@ -125,9 +125,9 @@
         let ptr = buf.as_mut_ptr().cast();
         let len = buf.capacity();
 
-        #[cfg(target_os = "macos")]
+        #[cfg(any(target_os = "macos", target_os = "freebsd", target_os = "dragonfly"))]
         let res = unsafe { libc::getdomainname(ptr, len as libc::c_int) };
-        #[cfg(target_os = "linux")]
+        #[cfg(any(target_os = "linux", target_os = "netbsd", target_os = "openbsd"))]
         let res = unsafe { libc::getdomainname(ptr, len as libc::size_t) };
 
         if res == -1 {
